# Optional database source. Create a key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Enables web-backed food research and context-aware text/photo meal parsing.
# Configure keys as Sites runtime secrets too; local .env is not deployed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.6-luna

# Optional voice transcription model override.
OPENAI_TRANSCRIBE_MODEL=whisper-1
